# BFF server port
BFF_PORT=3000

# Recipient mappings (first URL path segment -> upstream base URL)
# Requests like /cart?var1=someValue will be forwarded to ${CART_URL}?var1=someValue
# Requests like /product/products will be forwarded to ${PRODUCT_URL}/products
CART_URL=http://localhost:8083
PRODUCT_URL=http://localhost:8080
